rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The list of shop locations needs to be readable before login,
    // so the app can show the sign-in screen correctly.
    match /meta/locations {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Each location's own products/orders/etc — only signed-in accounts.
    match /business/{locationId} {
      allow read, write: if request.auth != null;
    }
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
